# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe in the browser: every table is
# protected by row level security, so it can only ever read the signed-in user's
# own rows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Bypasses RLS — server-side only, never exposed to the
# browser. Used for exactly one thing: reading and writing calendar OAuth
# tokens, which no client role is allowed to touch.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ─────────────────────────────────────────────────────────────────────
# Used for auth email redirect links. Set to your deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Temporary demo mode for local/public testing. Remove these when testing ends.
# DEMO_MODE=true
# DEMO_USER_ID=the-auth-user-id-containing-demo-data

# Shown on the privacy policy and terms pages, and required by Google's and
# Microsoft's OAuth verification. Set a real, monitored address before launch —
# a policy with an unreachable contact is worse than no policy.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# ─── Calendar (optional) ─────────────────────────────────────────────────────
# Leave a provider's variables unset and its card stays "Not configured";
# everything else in the app works either way.
#
# Only availability is ever requested:
#   Google    — calendar.freebusy, via the FreeBusy endpoint
#   Microsoft — Calendars.Read, via /me/calendar/getSchedule
# Neither grant can read event names, guests or locations, and neither can
# write. Do not widen these scopes.

# Encrypts OAuth tokens at rest (AES-256-GCM). 32 bytes, hex or base64:
#   openssl rand -hex 32
# Without it, calendar connections stay disabled — writing refresh tokens in
# plaintext is not an acceptable fallback.
CALENDAR_TOKEN_KEY=

# Origin the OAuth callbacks come back to. Defaults to NEXT_PUBLIC_SITE_URL.
# Register `<base>/api/calendar/google/callback` with Google and
# `<base>/api/calendar/outlook/callback` with Microsoft.
CALENDAR_REDIRECT_BASE_URL=http://localhost:3000

# Bearer token for the scheduled sync endpoint (GET /api/calendar/sync).
# 16+ characters. Without it that endpoint refuses every request.
CALENDAR_SYNC_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Legacy single-provider override, honoured if CALENDAR_REDIRECT_BASE_URL is unset.
GOOGLE_REDIRECT_URI=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# `common` allows both personal and work/school accounts. A tenant GUID pins one
# organisation.
MICROSOFT_TENANT=common
