{
  "name": "glowup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:bundle",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/db/database.types.ts"
  },
  "dependencies": {
